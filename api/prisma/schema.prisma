generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  google
  apple
}

model User {
  id                     String       @id @default(cuid())
  createdAt              DateTime     @default(now())
  email                  String?      @unique
  displayName            String?
  rating                 Int          @default(1000)
  tier                   String       @default("Bronze")
  timezone               String       @default("UTC")
  streakCount            Int          @default(0)
  lastDrillCompletedOn   String?
  weeklyForgivenessUsedOn String?

  identities   UserIdentity[]
  devices      Device[]
  drills       Drill[]
  mistakeStats UserMistakeStat[]
  entitlement  UserEntitlement?
}

model UserIdentity {
  id           String       @id @default(cuid())
  userId       String
  createdAt    DateTime     @default(now())
  provider     AuthProvider
  subject      String
  email        String?
  displayName  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  pushToken String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MistakeCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  scenarioGradings ScenarioGrading[]
  decisions        Decision[]
  userStats        UserMistakeStat[]
}

model Scenario {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  code             String   @unique
  street           String
  spotType         String
  difficultyRating Int      @default(1000)
  promptJson       Json

  choices   ScenarioChoice[]
  gradings  ScenarioGrading[]
  decisions Decision[]
}

model ScenarioChoice {
  id         String @id @default(cuid())
  scenarioId String
  label      String
  order      Int

  scenario  Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  gradings  ScenarioGrading[]
  decisions Decision[]

  @@unique([scenarioId, order])
}

model ScenarioGrading {
  id               String  @id @default(cuid())
  scenarioId        String
  choiceId          String
  isCorrect         Boolean
  mistakeCategoryId String?
  severity          Int?

  scenario        Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  choice          ScenarioChoice   @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  mistakeCategory MistakeCategory? @relation(fields: [mistakeCategoryId], references: [id])

  @@unique([scenarioId, choiceId])
}

model Drill {
  id              String   @id @default(cuid())
  userId          String
  createdAt       DateTime @default(now())
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  maxDecisions    Int      @default(10)
  ratingDeltaTotal Int     @default(0)
  decisionsCount  Int      @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions Decision[]
}

model Decision {
  id               String   @id @default(cuid())
  drillId          String
  scenarioId       String
  choiceId         String
  createdAt        DateTime @default(now())
  isCorrect        Boolean
  ratingDelta      Int
  responseMs       Int
  mistakeCategoryId String?

  drill          Drill            @relation(fields: [drillId], references: [id], onDelete: Cascade)
  scenario       Scenario         @relation(fields: [scenarioId], references: [id])
  choice         ScenarioChoice   @relation(fields: [choiceId], references: [id])
  mistakeCategory MistakeCategory? @relation(fields: [mistakeCategoryId], references: [id])
}

model UserMistakeStat {
  id               String   @id @default(cuid())
  userId           String
  mistakeCategoryId String
  wrongCount       Int      @default(0)
  lastWrongAt      DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mistakeCategory MistakeCategory @relation(fields: [mistakeCategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, mistakeCategoryId])
}

model UserEntitlement {
  id               String   @id @default(cuid())
  userId           String   @unique
  isPaid           Boolean  @default(false)
  currentPeriodEnd DateTime?
  source           String   @default("revenuecat")
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
